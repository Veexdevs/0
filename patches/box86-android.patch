diff --git a/src/emu/x86sysnr_compat.c b/src/emu/x86sysnr_compat.c
new file mode 100644
index 0000000..f158a69
--- /dev/null
+++ b/src/emu/x86sysnr_compat.c
@@ -0,0 +1,7 @@
+#include <math.h>
+
+/* bionic (NDK) nao fornece isinff (so o declara em alguns casos);
+ * o codigo box86 o declara sob #if TERMUX||ANDROID nos arquivos x86run*.c */
+#if defined(__ANDROID__) && !defined(TERMUX)
+int isinff(float x) { return isinf((double)x); }
+#endif
diff --git a/src/emu/x86sysnr_compat.h b/src/emu/x86sysnr_compat.h
new file mode 100644
index 0000000..e844ef3
--- /dev/null
+++ b/src/emu/x86sysnr_compat.h
@@ -0,0 +1,72 @@
+/* NovaWin compat: numeros de syscall x86 32-bits ausentes em hosts que nao
+ * sao i386 (x86-64/ARM32/ARM64, Linux ou Android/bionic).
+ * Os valores sao os oficiais da tabela i386 — sao usados como IDs de
+ * syscalls do GUEST x86, nao do host. */
+#ifndef __NR_clone
+#define __NR_clone 2
+#endif
+#ifndef __NR_sigprocmask
+#define __NR_sigprocmask 126
+#endif
+#ifndef __NR__llseek
+#define __NR__llseek 140
+#endif
+#ifndef __NR__newselect
+#define __NR__newselect 142
+#endif
+#ifndef __NR_ugetrlimit
+#define __NR_ugetrlimit 191
+#endif
+#ifndef __NR_stat64
+#define __NR_stat64 195
+#endif
+#ifndef __NR_lstat64
+#define __NR_lstat64 196
+#endif
+#ifndef __NR_fstat64
+#define __NR_fstat64 197
+#endif
+#ifndef __NR_getuid32
+#define __NR_getuid32 199
+#endif
+#ifndef __NR_getgid32
+#define __NR_getgid32 200
+#endif
+#ifndef __NR_geteuid32
+#define __NR_geteuid32 201
+#endif
+#ifndef __NR_getegid32
+#define __NR_getegid32 202
+#endif
+#ifndef __NR_setresuid32
+#define __NR_setresuid32 208
+#endif
+#ifndef __NR_setresgid32
+#define __NR_setresgid32 209
+#endif
+#ifndef __NR_getresuid32
+#define __NR_getresuid32 210
+#endif
+#ifndef __NR_getresgid32
+#define __NR_getresgid32 211
+#endif
+#ifndef __NR_tgkill
+#define __NR_tgkill 269
+#endif
+#ifndef __NR_futex_waitv
+#define __NR_futex_waitv 449
+#endif
+// em hosts 64-bits o sigaction do guest e atendido pelo rt_sigaction (n. 13);
+// em i386/ARM32 o __NR_sigaction nativo ja existe e e usado
+#ifndef __NR_sigaction
+#define __NR_sigaction 13
+#endif
+
+/* bionic aarch64 nao tem stat64()/lstat64()/fstat64() nem struct stat64;
+ * a la o stat nativo ja e 64-bits. (Em i386/ARM32 o stat64 existe.)
+ * O #define substitui tambem a tag 'struct stat64' -> 'struct stat'. */
+#if defined(__ANDROID__) && defined(__aarch64__)
+#define stat64 stat
+#define lstat64 lstat
+#define fstat64 fstat
+#endif
diff --git a/src/libtools/myalignsys64.c b/src/libtools/myalignsys64.c
index 0e6e2d1..3df17f8 100644
--- a/src/libtools/myalignsys64.c
+++ b/src/libtools/myalignsys64.c
@@ -18,13 +18,17 @@
 void UnalignSysStat64(const void* source, void* dest)
 {
     struct i386_stat64 *i386st = (struct i386_stat64*)dest;
+#if defined(__aarch64__) || defined(__x86_64__)
+    struct stat *st = (struct stat*) source;
+#else
     struct stat64 *st = (struct stat64*) source;
+#endif
     
     i386st->__pad0 = 0;
 	i386st->__pad3 = 0;
     i386st->st_dev      = st->st_dev;
 #ifndef POWERPCLE
-    i386st->__st_ino    = st->__st_ino;
+    i386st->__st_ino    = st->st_ino;
 #else
     i386st->__st_ino    = st->st_ino; // Separate __st_ino doesn't 
                                       // exist on powerpc
